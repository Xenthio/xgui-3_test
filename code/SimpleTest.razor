@using Sandbox;
@using Sandbox.UI;
@using System.Collections.Generic;
@using System.Linq;
@using XGUI;
@attribute [StyleSheet( "/XGUI/DefaultStyles/OliveGreen.scss" )]
@inherits Window

<root title="Hello" hasminimise="true" hasmaximise="true">
	Hello, I am a window!
	<button @ref=ButtonTest @onclick=@Test>okay</button>
        <tabcontrol>
            <tab tabName="general" slot="tab" tabtext="General">
				<div style="width:300px;height:200px;">
					<sliderscaleentry min=1 max=10 mintext="1.00" maxtext="10.0" step=1>
						
					</sliderscaleentry>
					<sliderscale min=1 max=10 mintext="1.00" maxtext="10.0" step=1>

					</sliderscale>
					<slider min=1 max=10 mintext="1.00" maxtext="10.0" step=1>

					</slider>
					<check>checkbox</check>
					<button >HI!!!</button> 
					<textentry>

					</textentry> 
					<radiobuttons>

					</radiobuttons> 
				</div>
			</tab>
            <tab tabName="video" slot="tab" tabtext="Video">
				<div style="width:300px;height:200px;">

				</div>
			</tab>
            <tab tabName="audio" slot="tab" tabtext="Audio">
				<div style="width:300px;height:200px;">

				</div>
			</tab>
		</tabcontrol>
	<resizer>

	</resizer>
</root>

@code{

	private Button ButtonTest;
	void Test()
	{
		Log.Info($"Button Clicked! Button PointerEvents: {ButtonTest.ComputedStyle.PointerEvents}");//, Button Label PointerEvents: {ButtonTest.Children.First().ComputedStyle.PointerEvents}");
		// Log all children pointer events and the children name
		foreach ( var child in ButtonTest.Children )
		{
			Log.Info($"Child: {child.ElementName}, PointerEvents: {child.ComputedStyle.PointerEvents}");
		}
	}
}